# =============================================================================
# Soroban Watchdog - Exhaustive Environment Variable Configuration Reference
# =============================================================================

# Server Environment & Networking
NODE_ENV=development
PORT=4000

# PostgreSQL Database Connection String (Prisma ORM)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/soroban_watchdog?schema=public

# Redis Connection URL (BullMQ Async Alert Queue)
REDIS_URL=redis://localhost:6379

# Stellar Soroban RPC Endpoint (Stellar Testnet / Mainnet)
# Default Testnet RPC: https://soroban-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# AES-256-GCM Secret Encryption Key (Must be 32 raw bytes = exactly 64 hex characters)
# Used to encrypt sensitive webhook URLs and Telegram bot tokens at rest in PostgreSQL.
# Generate in bash/node: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Event Ingestion Poller Configuration
# Frequency in milliseconds between poll loop iterations
POLL_INTERVAL_MS=5000
# Maximum events requested per RPC batch page
MAX_EVENTS_PER_BATCH=100
# Optional default contract to monitor on initial startup
MONITOR_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Logging & Observability
# Options: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info
