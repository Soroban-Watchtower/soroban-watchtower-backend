# Environment Configuration Blueprint
NODE_ENV=development
PORT=4000

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/soroban_watchdog?schema=public

# Redis Connection (BullMQ Queue)
REDIS_URL=redis://localhost:6379

# Soroban RPC Endpoint (Stellar Testnet)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# AES-256-GCM Secret Encryption Key (32 hex bytes = 64 characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Ingestion Worker Settings
POLL_INTERVAL_MS=5000
MAX_EVENTS_PER_BATCH=100
LOG_LEVEL=info
