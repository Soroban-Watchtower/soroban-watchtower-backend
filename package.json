{
  "name": "soroban-watchdog-backend",
  "version": "0.1.0",
  "description": "Telemetry, anomaly surveillance, and exploit-alerting engine for Stellar Soroban smart contracts",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:ingest": "tsx watch src/ingest/poller.ts",
    "dev:notify": "tsx watch src/queue/alertWorker.ts",
    "start": "node dist/index.js",
    "replay-failed-events": "tsx src/ingest/replay.ts",
    "prune-failed-events": "tsx src/ingest/prune.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "stellar",
    "soroban",
    "smart-contracts",
    "telemetry",
    "security",
    "monitoring",
    "alerts"
  ],
  "author": "Soroban Watchtower",
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@prisma/client": "^5.14.0",
    "@stellar/stellar-sdk": "^12.0.1",
    "bullmq": "^5.7.9",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "fastify-type-provider-zod": "^2.0.0",
    "ioredis": "^5.4.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
